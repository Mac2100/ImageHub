<!--
  Light palette. Every key here also exists in Dark.xaml with the same name, and
  Controls.xaml only ever reaches them through DynamicResource, so swapping this
  dictionary for the dark one re-themes a running window.

  Values follow the Windows 11 (Fluent) light theme so the app sits next to
  Settings and Explorer rather than inventing its own look. Accent* is a
  placeholder: ThemeManager overwrites it from the chosen accent theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <SolidColorBrush x:Key="WindowBg" Color="#FFF3F3F3" />
  <SolidColorBrush x:Key="ContentBg" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SidebarBg" Color="#FFEDEDED" />
  <SolidColorBrush x:Key="BarBg" Color="#FFF7F7F7" />
  <SolidColorBrush x:Key="MenuBg" Color="#FFFBFBFB" />
  <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SubtleBg" Color="#FFF6F6F6" />
  <SolidColorBrush x:Key="LogBg" Color="#FFF7F7F7" />

  <!-- Lines -->
  <SolidColorBrush x:Key="CardBorder" Color="#FFE2E2E2" />
  <SolidColorBrush x:Key="DividerBrush" Color="#FFE6E6E6" />
  <SolidColorBrush x:Key="ControlBorder" Color="#FFD2D2D2" />
  <SolidColorBrush x:Key="ControlBorderHover" Color="#FFB9B9B9" />

  <!-- Controls -->
  <SolidColorBrush x:Key="ControlBg" Color="#FFFDFDFD" />
  <SolidColorBrush x:Key="ControlBgHover" Color="#FFF5F5F5" />
  <SolidColorBrush x:Key="ControlBgPressed" Color="#FFEDEDED" />
  <SolidColorBrush x:Key="FieldBg" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="HoverBg" Color="#12000000" />
  <SolidColorBrush x:Key="PressedBg" Color="#1F000000" />
  <SolidColorBrush x:Key="SelectedBg" Color="#FFE4E4E4" />
  <SolidColorBrush x:Key="ThumbBrush" Color="#FF9A9A9A" />
  <SolidColorBrush x:Key="TrackBrush" Color="#FFE1E1E1" />

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimary" Color="#FF1B1B1B" />
  <SolidColorBrush x:Key="TextSecondary" Color="#FF5C5C5C" />
  <SolidColorBrush x:Key="TextTertiary" Color="#FF868686" />
  <SolidColorBrush x:Key="TextDisabled" Color="#FFA3A3A3" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />

  <!-- Status -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF0F7B0F" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FF9D5D00" />
  <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />
  <SolidColorBrush x:Key="InfoBrush" Color="#FF0F6CBD" />

  <!-- Accent: replaced at runtime by ThemeManager. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#FF2966EB" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF3C77F0" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF2159CE" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1A2966EB" />
  <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#FF5CBDF5" />

</ResourceDictionary>
